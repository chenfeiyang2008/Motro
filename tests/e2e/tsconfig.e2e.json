{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": false,
    "emitDeclarationOnly": false,
    "sourceMap": false,
    "composite": false,
    "skipLibCheck": true
  },
  "include": [
    "run-import-e2e.ts",
    "run-restart-e2e.ts",
    "run-crash-recovery-e2e.ts",
    "import-e2e-db.ts",
    "import-e2e-lib.ts"
  ],
  "references": [
    { "path": "../../apps/api" },
    { "path": "../../packages/config" },
    { "path": "../../packages/db" }
  ]
}
