# Motro 本地开发环境示例值。
# 复制为 .env 后使用：cp .env.example .env
# 这些值仅供本地开发；生产环境敏感值必须由运行时 secret 注入，不得写入本文件。

# 环境
NODE_ENV=development

# PostgreSQL（对应 compose/docker-compose.yml 的 db 服务）
POSTGRES_DB=motro
POSTGRES_USER=motro
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_PORT=5432

# Cookie / CSRF（本地开发占位值；生产必须由 secret 注入）
SESSION_KEY=development-only-session-key-0123456789abcdef
CSRF_KEY=development-only-csrf-key-0123456789abcdef
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_IDLE_MINUTES=30
COOKIE_ABSOLUTE_HOURS=168
CSRF_HEADER_NAME=x-csrf-token

# API / Web
API_PORT=3000
WEB_PORT=3001
API_PUBLIC_URL=http://127.0.0.1:3000
API_INTERNAL_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://127.0.0.1:3001

# 日志 / OpenAPI / 限速
LOG_LEVEL=info
OPENAPI_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10

# 导入原始文件（阶段 6 工单 01 + 02 + 02-review）
# fileRootDir 仅是服务端可写目录，绝不写入 API 响应；相对路径以进程工作目录为基准。
IMPORT_FILE_ROOT_DIR=.local-import-files
IMPORT_MAX_FILE_BYTES=10485760
IMPORT_ALLOWED_FORMATS=txt,csv,json,xlsx
# 工单 02：解析/校验输入安全边界（保守开发默认值；生产值由部署注入）。
IMPORT_MAX_ROWS=50000
IMPORT_MAX_CELL_LENGTH=1000
IMPORT_MAX_JSON_DEPTH=10
IMPORT_MAX_SHEETS=50
IMPORT_MAX_CELLS=200000
IMPORT_MAX_SUMMARY_LENGTH=120
# 02-review：XLSX ZIP 预检（4 GB 家庭服务器安全防护）。
IMPORT_MAX_ZIP_ENTRIES=1024
IMPORT_MAX_ZIP_UNCOMPRESSED_BYTES=268435456
IMPORT_MAX_ZIP_EXPANSION_RATIO=100
