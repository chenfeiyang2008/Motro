{
  "name": "motro",
  "version": "0.0.0",
  "private": true,
  "description": "Motro — 面向小规模受邀用户的英语词汇学习系统（monorepo）",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "format": "prettier --check .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --build --pretty",
    "test": "vitest run --passWithNoTests",
    "build": "tsc --build --pretty",
    "db:migrate": "tsc --build packages/db && node --env-file-if-exists=.env packages/db/dist/cli-migrate.js",
    "db:migrate:check": "tsc --build packages/db && node --env-file-if-exists=.env packages/db/dist/cli-migrate-check.js",
    "db:bootstrap-admin": "tsc --build packages/db && node --env-file-if-exists=.env packages/db/dist/cli-bootstrap-admin.js",
    "config:check": "tsc --build packages/config && node packages/config/dist/cli-config-check.js",
    "openapi:generate": "tsc --build apps/api && node apps/api/dist/openapi-generate.js",
    "openapi:check": "tsc --build apps/api && node apps/api/dist/openapi-check.js",
    "openapi:types": "openapi-typescript docs/generated/openapi.json -o packages/api-client/src/generated.ts",
    "e2e:import": "pnpm build && pnpm exec tsc -p tests/e2e/tsconfig.e2e.json && node tests/e2e/dist/run-import-e2e.js",
    "worker:migrate": "tsc --build apps/worker && node --env-file-if-exists=.env apps/worker/dist/worker-migrate.js",
    "worker:start": "tsc --build apps/worker && node --env-file-if-exists=.env apps/worker/dist/worker-main.js",
    "worker:once": "tsc --build apps/worker && node --env-file-if-exists=.env apps/worker/dist/worker-once.js",
    "e2e:restart": "pnpm build && pnpm exec tsc -p tests/e2e/tsconfig.e2e.json && node tests/e2e/dist/run-restart-e2e.js",
    "e2e:crash-recovery": "pnpm build && pnpm exec tsc -p tests/e2e/tsconfig.e2e.json && node tests/e2e/dist/run-crash-recovery-e2e.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "find-my-way": "9.8.0",
      "js-yaml@4": "4.3.1",
      "js-yaml@5": "5.2.2",
      "nanoid": "3.3.18"
    }
  }
}
