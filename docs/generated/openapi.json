  "info": {
    "title": "Motro API",
    "description": "Motro v1 版本化 REST API（平台基础阶段仅含健康检查）",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "登录用户名"
          },
          "password": {
            "type": "string",
            "description": "密码"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "description": "当前密码（或一次性密码）"
          },
          "newPassword": {
            "type": "string",
            "description": "新密码"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "登录用户名（小写）"
          },
          "displayName": {
            "type": "string",
            "description": "显示名"
          },
          "timezone": {
            "type": "string",
            "description": "IANA 时区"
          },
          "dailyBudgetMinutes": {
            "type": "number",
            "description": "每日时间预算（分钟）",
            "minimum": 1,
            "maximum": 120
          },
          "role": {
            "type": "string",
            "enum": [
              "learner",
              "admin"
            ],
            "default": "learner"
          }
        },
        "required": [
          "username",
          "displayName",
          "timezone",
          "dailyBudgetMinutes",
          "role"
        ]
      }
    }
  }
}